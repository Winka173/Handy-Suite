<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/handy_widget_bg">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="bottom">
        <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="22sp" android:fontFamily="sans-serif-black" android:maxLines="1" />
        <TextView android:id="@+id/detail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" android:max="100" android:progressTint="@color/handy_widget_accent" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/handy_widget_empty" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/name0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <ImageView android:id="@+id/beads0" android:layout_width="wrap_content" android:layout_height="13dp"
                android:layout_marginTop="3dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView android:id="@+id/bead0" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="4dp" android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/name1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <ImageView android:id="@+id/beads1" android:layout_width="wrap_content" android:layout_height="13dp"
                android:layout_marginTop="3dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView android:id="@+id/bead1" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="4dp" android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/name2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <ImageView android:id="@+id/beads2" android:layout_width="wrap_content" android:layout_height="13dp"
                android:layout_marginTop="3dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView android:id="@+id/bead2" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="4dp" android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/name3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <ImageView android:id="@+id/beads3" android:layout_width="wrap_content" android:layout_height="13dp"
                android:layout_marginTop="3dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView android:id="@+id/bead3" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="4dp" android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/name4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <ImageView android:id="@+id/beads4" android:layout_width="wrap_content" android:layout_height="13dp"
                android:layout_marginTop="3dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView android:id="@+id/bead4" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="4dp" android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
