<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/handy_widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="bottom">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        <ImageView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="14dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/locked" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/wrow0" android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/wname0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <ImageView android:id="@+id/wbeads0" android:layout_width="wrap_content" android:layout_height="16dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wrow1" android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/wname1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <ImageView android:id="@+id/wbeads1" android:layout_width="wrap_content" android:layout_height="16dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wrow2" android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/wname2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <ImageView android:id="@+id/wbeads2" android:layout_width="wrap_content" android:layout_height="16dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wrow3" android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/wname3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <ImageView android:id="@+id/wbeads3" android:layout_width="wrap_content" android:layout_height="16dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wrow4" android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/wname4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <ImageView android:id="@+id/wbeads4" android:layout_width="wrap_content" android:layout_height="16dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wrow5" android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/wname5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <ImageView android:id="@+id/wbeads5" android:layout_width="wrap_content" android:layout_height="16dp"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
