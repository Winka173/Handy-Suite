<?xml version="1.0" encoding="utf-8"?>
<!-- Sharing shortcuts: the person's collections in the top row of the
     share sheet (published by ShareTargets.kt, Android 10+). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.example.handysuite.save.ShareActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/jpeg" />
        <data android:mimeType="image/png" />
        <data android:mimeType="image/webp" />
        <category android:name="com.example.handysuite.save.SHARE_TO_COLLECTION" />
    </share-target>
</shortcuts>
